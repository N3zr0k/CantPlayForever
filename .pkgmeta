# BigWigs-Packager: Der Addon-Ordner liegt im Unterordner CantPlayForever (keine TOC im Repo-Stamm),
# deshalb package-as. Eingebettete Bibliotheken liegen unter CantPlayForever/Libs (kein externals-Abruf nötig).
package-as: CantPlayForever
ignore:
  - .github
  - docs
  - tests
  - tools
  - README.md
  - CHANGELOG.md
  - LICENSE
  - .luacheckrc
  - .gitattributes
  - .gitignore
